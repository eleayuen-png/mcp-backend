# === Required (already set on Render) ===
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
STRIPE_SECRET_KEY=sk_live_...
GEMINI_API_KEY=...

# === Analytics — add these to Render env vars ===
# Personal API key from PostHog → Settings → Project Settings → API Keys → Personal API Keys
# Looks like phx_... (NOT the phc_... project token)
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key_here
# Found in PostHog URL: posthog.com/project/XXXXXX
POSTHOG_PROJECT_ID=435992

# Comma-separated list of admin Google email addresses
ADMIN_EMAILS=admin@example.com
